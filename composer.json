{
    "name": "itk-dev/itqr",
    "description": "A QR code generator",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "api-platform/core": "^4.4.10",
        "doctrine/dbal": "^3.10.7",
        "doctrine/doctrine-bundle": "^2.19.4",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.8.0",
        "easycorp/easyadmin-bundle": "^4.29.18",
        "endroid/qr-code-bundle": "^6.1",
        "itk-dev/openid-connect-bundle": "^4.2.0",
        "itk-dev/tidy-feedback": "^1.0",
        "symfony/console": "^7.4.24",
        "symfony/dotenv": "^7.4.18",
        "symfony/flex": "^2.12.0",
        "symfony/framework-bundle": "^7.4.24",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/runtime": "^7.4.24",
        "symfony/twig-bundle": "^7.4.21",
        "symfony/ux-twig-component": "^2.36.0",
        "symfony/webpack-encore-bundle": "^2.4.3",
        "symfony/yaml": "^7.4.24",
        "twig/twig": "^3.31.1"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "ergebnis/composer-normalize": "^2.59",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-deprecation-rules": "^2.0.6",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-phpunit": "^2.1.3",
        "phpstan/phpstan-symfony": "^2.1.1",
        "symfony/stopwatch": "^7.4.24",
        "symfony/web-profiler-bundle": "^7.4.24",
        "vincentlanglet/twig-cs-fixer": "^3.14.0"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "RC",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "code-analysis": [
            "@code-analysis/phpstan"
        ],
        "code-analysis/phpstan": [
            "phpstan analyse --configuration=phpstan.dist.neon"
        ],
        "coding-standards-apply": [
            "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix",
            "@coding-standards-apply/twig-cs-fixer"
        ],
        "coding-standards-apply/twig-cs-fixer": [
            "twig-cs-fixer lint templates --fix"
        ],
        "coding-standards-check": [
            "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --dry-run",
            "@coding-standards-check/twig-cs-fixer"
        ],
        "coding-standards-check/twig-cs-fixer": [
            "twig-cs-fixer lint templates"
        ],
        "phpstan": [
            "./vendor/bin/phpstan"
        ]
    }
}
